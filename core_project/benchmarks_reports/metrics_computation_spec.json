      "input_variables": ["I_sr (uint8 [0, 255])", "M_roi (Mask mô quan tâm)", "M_bg (Mask nền xung quanh)"],
      "formula_text": "CNR = abs(mean(ROI) - mean(BG)) / sqrt(std(ROI)² + std(BG)²)",
      "python_code": "def compute_cnr(img, mask_roi, mask_bg):\n    roi_vals = img[mask_roi > 0].astype(np.float64)\n    bg_vals = img[mask_bg > 0].astype(np.float64)\n    return float(abs(np.mean(roi_vals) - np.mean(bg_vals)) / np.sqrt(np.var(roi_vals) + np.var(bg_vals) + 1e-8))",
      "extracted_values": {
        "Swift_SRGAN_Historical_Mean": 0.0032,
        "Swift_SRGAN_Historical_Std": 0.0013
      }
    },
